	"engines": {
		"node": ">=22.0.0",
		"npm": ">=10.0.0"
	},
	"devDependencies": {
		"@types/node": "^25.5.0",
		"@typescript-eslint/eslint-plugin": "8.57.2",
		"@typescript-eslint/parser": "8.57.2",
		"builtin-modules": "5.0.0",
		"esbuild": "0.27.4",
		"lightningcss": "^1.32.0",
		"obsidian": "latest",
		"ts-node": "^10.9.2",
		"tslib": "2.8.1",
		"typescript": "5.9.3"
	},
	"dependencies": {
		"i18next": "^25.8.18"
