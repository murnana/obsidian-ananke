{
	"private": true,
	"name": "obsidian-ananke",
	"version": "0.0.1",
	"description": "Obisidian plugin for estimating, recording, and reviewing tasks.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
